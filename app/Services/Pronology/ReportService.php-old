        // $this->Output(public_path('pdf_downloaded/' . $name . '.pdf'), 'F');
        $this->Output('D', 'Pronology_Report_' . $name . '.pdf');
        exit;
    }

    private function personalYearPage($dob)
    {
        // $pdf->Cell(0, 50, 'Numerology Report For', 0, 0, 'C');
        $this->SetFont('Arial', 'B', 16);
        // Personal Year Number Page Start
        $this->Cell(189, 10, '5 Year Analysis', 0, 1, 'C');
        $this->SetFont('Arial', '', 10);
        $d = date('d', strtotime($dob));
        $m = date('m', strtotime($dob));
        $y = date('Y', strtotime($dob));
        $currentYear = date('Y');
        $this->Cell(189, 5, htmlspecialchars('The personal year number gives you clue as to what lies ahead in the coming year. Your Maturity and development take'), 0, 1);
        $this->Cell(189, 5, htmlspecialchars('place in nine-year stages. Each nine year period marks the beginning and the end of a particular stage of development.'), 0, 1);
        $this->Cell(189, 5, htmlspecialchars('In nutshell, this number tells you how the particular year will be for you.'), 0, 1);
        for ($i = $currentYear; $i <= ($currentYear + 4); $i++) {
            $this->SetFont('Arial', 'B', '12');
            $newDob = digSum1($d . '' . $m . '' . $i);
            $this->Cell(189, 7, 'Year - ' . $i . ', Your Personal Number is - ' . $newDob, 0, 1);
            $resPYT = DB::table('personal_year_table')->where('personal_year_number', $newDob)->first();

                $this->SetFont('Arial', '', 10);
                foreach (explode("()", $resPYT->msg1) as $val) {
                    $this->Cell(189, 7, str_replace(array("``", "`", ";", "’"), "'", $val), 0, 1);
                }

        }
    }


private function manualNamePage($manualData)
{
    // --- Header ---
    $this->SetFont('Arial', 'B', 16);
    $this->SetTextColor(23, 198, 83); // Green color
    $this->Cell(0, 10, 'Name Suggestion As Per Numerology', 0, 1, 'C');

    // Line separator
    $this->SetDrawColor(50, 50, 50);
    $this->SetLineWidth(0.5);
    $this->Line(10, $this->GetY(), 200, $this->GetY());
    $this->Ln(10);

    // --- Content ---
    $this->SetTextColor(0, 0, 0);
    $this->SetLineWidth(0.2);

    // Map DB keys to Display Labels
    $sets = [
        'Name Suggestion-1' => ' Name Fixed Suggestion 1',
        'Name Suggestion-2' => ' Name Fixed Suggestion 2',
        'Name Suggestion-3' => ' Name Fixed Suggestion 3'
    ];

    $hasPrintedAny = false;

    foreach ($sets as $key => $label) {
        $firstName = $manualData[$key]['first_name'] ?? '';
        $fullName  = $manualData[$key]['full_name'] ?? '';
        
        // Get the totals from DB
        $fScore = $manualData[$key]['first_name_score'] ?? '';
        $flScore = $manualData[$key]['full_name_score'] ?? '';

        if (!empty($firstName) || !empty($fullName)) {
            
            $hasPrintedAny = true;

            // --- Suggestion Heading (Gray Background) ---
            $this->SetFont('Arial', 'B', 12);
            $this->SetFillColor(230, 230, 230);
            $this->Cell(190, 10, '  ' . $label, 1, 1, 'L', true);

            // --- First Name Block ---
            if(!empty($firstName)) {
                // Name Row
                $this->SetFont('Arial', 'B', 11);
                $this->Cell(50, 10, '  First Name', 1, 0, 'L');
                $this->SetFont('Arial', '', 11);
                $this->Cell(140, 10, '  ' . $firstName, 1, 1, 'L');

                // Total Row (Only if score exists)
                if(!empty($fScore)) {
                    $this->SetFont('Arial', 'B', 11);
                    $this->Cell(50, 10, '  Name Total', 1, 0, 'L');
                    $this->SetFont('Arial', '', 11);
                    $this->Cell(140, 10, '  ' . $fScore, 1, 1, 'L');
                }
            }

            // --- Full Name Block ---
            if(!empty($fullName)) {
                // Name Row
                $this->SetFont('Arial', 'B', 11);
                $this->Cell(50, 10, '  Full Name', 1, 0, 'L');
                $this->SetFont('Arial', '', 11);
                $this->Cell(140, 10, '  ' . $fullName, 1, 1, 'L');

                // Total Row (Only if score exists)
                if(!empty($flScore)) {
                    $this->SetFont('Arial', 'B', 11);
                    $this->Cell(50, 10, '  Name Total', 1, 0, 'L');
                    $this->SetFont('Arial', '', 11);
                    $this->Cell(140, 10, '  ' . $flScore, 1, 1, 'L');
                }
            }

            $this->Ln(8); // Gap between sets
        }
    }

    // --- Footer Note ---
    if ($hasPrintedAny) {
        $this->Ln(5);
        $this->SetFont('Arial', 'I', 10); // Italic, slightly smaller
        $this->SetTextColor(80, 80, 80); // Dark Gray
        
        // Using MultiCell to ensure text wraps if it gets too long
        $this->MultiCell(190, 6, 'Note: As per your DOB, above is suggested name aligned.', 0, 'L');
    }
}

 private function checkDiezn($fullName)
    {
        // 1. Convert name to lowercase so we match 'D' and 'd' equally
        $cleanName = strtolower($fullName);

        // 2. Define the specific target characters (DIEZN)
        $targetChars = ['d', 'i', 'e', 'z','h', 'n'];

        // 3. Loop through only these specific characters
        foreach ($targetChars as $char) {

            // Count how many times this specific char appears in the name
            $count = substr_count($cleanName, $char);

            // 4. If any of them appears 3 or more times, trigger the warning
            if ($count >= 3) {
                return "Since the character '$char' comes 3 times or more in your name, you could face health issues in life. Please contact a numerologist to fix your name.";
            }
        }

        return null; // Logic passed, no warning needed
    }






