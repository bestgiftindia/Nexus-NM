<?php

namespace App\Services\Pronology;

use App\Models\FindLuckyUnluckyNumbersModel;
use App\Models\LuckyUnluckyNumber;
use Illuminate\Support\Facades\DB;
use FPDF;

class ReportService extends FPDF
{
    const DPI = 96;
    const MM_IN_INCH = 25.4;
    const A4_HEIGHT = 210;
    const A4_WIDTH = 297;
    const MAX_WIDTH = 500;
    const MAX_HEIGHT = 700;

    private $generateReportId;
    private $custId;
    private $name;
    private $filename;
    private $dob;
    private $firstName;
    private $mnum;

    public function __construct($generateReportId)
    {
        parent::__construct();
        $this->generateReportId = $generateReportId;
    }

    public function pixelsToMM($val)
    {
        return $val * self::MM_IN_INCH / self::DPI;
    }

    public function resizeToFit($imgFilename)
    {
        list($width, $height) = getimagesize($imgFilename);
        $widthScale = self::MAX_WIDTH / $width;
        $heightScale = self::MAX_HEIGHT / $height;
        $scale = min($widthScale, $heightScale);
        return [
            round($this->pixelsToMM($scale * $width)),
            round($this->pixelsToMM($scale * $height))
        ];
    }

    public function centerImage($img)
    {
        list($width, $height) = $this->resizeToFit($img);
        $this->Image(
            $img,
            (self::A4_HEIGHT - $width) / 2,
            (self::A4_WIDTH - $height) / 2,
            $width,
            $height
        );
    }

    public function Header()
    {
        $result = DB::table('namenumerology')
            ->where('id', $this->generateReportId)
            ->first();

        if ($result) {
            $this->name = $result->first_name . ' ' . $result->middle_name . ' ' . $result->last_name;
            $this->filename = $result->first_name . $result->middle_name . $result->last_name;
            $this->firstName = $result->first_name;
            $this->dob = $result->date_of_birth;
        }

        $this->SetFont('Arial', 'I', 10);
        $this->Cell(0, 2, $this->name, 0, 0, 'L');
        $this->Cell(0, 2, $this->dob, 0, 1, 'R');
        $hr = str_repeat('-', 190);
        $this->Cell(189, 2, $hr, 0, 1);
    }

    public function Footer()
    {
        $this->SetY(-15);
        $hr = str_repeat('-', 190);
        $this->Cell(189, 2, $hr, 0, 1);
        $this->SetFont('Arial', 'I', 8);
    }

