        $this->SetTextColor(0, 0, 0);

        // Reset font for the body text
        $this->SetFont('Arial', '', 15);

        $pred = '';
        $firstLetter = strtoupper(substr($str, 0, 1));  // Get the first letter of the string

        // Query the database for prediction based on the first letter
        $firstLetterResult = DB::table('namenumerologyalphamaster')
            ->where('alphabet', $firstLetter)
            ->first();

        if ($firstLetterResult) {
            $pred = $firstLetterResult->description . ' ';
        } else {
            $pred = "No prediction found for the first letter '$firstLetter'. ";
        }

        // Output the prediction information to the this
        $this->MultiCell(189, 10, str_replace(array('``', '`', ';', '’', '“', '”'), "'", $pred), 0, 1, 'C');

        $this->AddPage('P');
        $this->personalYearPage($this->dob);

         $this->AddPage('P');
         $this->missingNumberRemedies($varOneNew, $varTwoNew, $varThreeNew, $varFourNew, $varFiveNew, $varSixNew, $varSevenNew, $varEightNew, $varNineNew);
        $dieznWarning = $this->checkDiezn($name);
