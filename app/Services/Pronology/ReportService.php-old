        $this->SetFont('Arial', 'B', 14);
        $this->SetTextColor(0, 0, 0);

        // Reset font for the body text
        $this->SetFont('Arial', '', 15);

        $soundAndVibration = '';

        $str = strtoupper($name);  // Assuming $filename is the input string

