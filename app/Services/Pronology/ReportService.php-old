        $soundAndVibrationResults = DB::table('namenumerologymaster')
            ->select('nameString', 'vibration')
            ->whereRaw("'$str' LIKE CONCAT('%', nameString, '%')")
            ->get();

        if ($soundAndVibrationResults->isNotEmpty()) {
            // Output the vibration of each substring found
